{
  "families": [
    {
      "family": "button",
      "priority": "high",
      "required_states": [
        "default",
        "hover",
        "active",
        "disabled",
        "loading"
      ],
      "components": [
        "primary-button",
        "secondary-button",
        "ghost-button",
        "icon-button",
        "cta-button"
      ]
    },
    {
      "family": "feedback",
      "priority": "high",
      "required_states": [
        "info",
        "success",
        "warning",
        "danger"
      ],
      "components": [
        "reason-chip",
        "top-pick-badge",
        "price-highlight-badge",
        "inline-alert",
        "empty-state",
        "toast"
      ]
    },
    {
      "family": "input",
      "priority": "high",
      "required_states": [
        "default",
        "focus",
        "error",
        "disabled"
      ],
      "components": [
        "tone-selector",
        "mood-tag-selector",
        "budget-range-slider",
        "upload-dropzone",
        "multi-item-selector",
        "text-field",
        "search-field",
        "segmented-control"
      ]
    },
    {
      "family": "navigation",
      "priority": "high",
      "required_states": [
        "default",
        "active",
        "hover",
        "collapsed"
      ],
      "components": [
        "mobile-topbar",
        "mobile-tab-bar",
        "back-button",
        "section-tabs"
      ]
    },
    {
      "family": "data-display",
      "priority": "medium",
      "required_states": [
        "default"
      ],
      "components": [
        "score-bar-chart",
        "comparison-overlay-chart",
        "price-compare-table",
        "closet-grid",
        "item-score-badge",
        "analysis-summary-card"
      ]
    },
    {
      "family": "foundation",
      "priority": "medium",
      "required_states": [
        "default"
      ],
      "components": [
        "step-progress",
        "preference-card",
        "outfit-feed-card",
        "tpo-filter-tab",
        "save-toggle",
        "recommendation-reason-list",
        "merchant-row",
        "similar-item-card",
        "premium-gate-card"
      ]
    },
    {
      "family": "overlay",
      "priority": "medium",
      "required_states": [
        "closed",
        "opening",
        "open"
      ],
      "components": [
        "outfit-detail-sheet",
        "try-on-preview",
        "generation-state-panel",
        "bottom-sheet",
        "modal-dialog"
      ]
    }
